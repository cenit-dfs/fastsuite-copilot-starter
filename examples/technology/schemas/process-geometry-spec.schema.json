{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/e2/technology/process-geometry-spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "example_id", "target_release", "source_units", "rotation_order", "pending_modifiers", "phases", "runtime_validation"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "spec_version": {"const": 1},
    "example_id": {"type": "string", "minLength": 1},
    "target_release": {"const": "FASTSUITE E2 R2026.1"},
    "source_units": {"const": "millimetres"},
    "rotation_order": {"const": "Rx * Ry * Rz"},
    "pending_modifiers": {"type": "array", "items": {"enum": ["Speed", "Wait"]}, "uniqueItems": true},
    "phases": {"type": "array", "minItems": 1, "items": {"enum": ["import", "workmethod-sync", "autoexecute"]}, "uniqueItems": true},
    "runtime_validation": {"enum": ["pending", "passed", "failed"]}
  }
}
