{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/e2/technology/attributes-spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "example_id", "target_release", "owner", "callbacks", "attributes", "runtime_validation"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "spec_version": {"const": 1},
    "example_id": {"type": "string", "minLength": 1},
    "target_release": {"const": "FASTSUITE E2 R2026.1"},
    "owner": {"enum": ["technology", "workmethod", "technology-and-workmethod"]},
    "callbacks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "attributes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "scope"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["Bool", "Double", "Int", "String", "Enum"]},
          "scope": {"enum": ["technology", "workmethod", "event", "process-geometry"]},
          "nls_key": {"type": "string", "minLength": 1},
          "initial_visibility": {"type": "boolean"}
        }
      }
    },
    "runtime_validation": {"enum": ["pending", "passed", "failed"]}
  }
}
