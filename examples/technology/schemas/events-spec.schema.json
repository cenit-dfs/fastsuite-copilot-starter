{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/e2/technology/events-spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "example_id", "target_release", "registration_owner", "events", "rule_bindings", "runtime_validation"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "spec_version": {"const": 1},
    "example_id": {"type": "string", "minLength": 1},
    "target_release": {"const": "FASTSUITE E2 R2026.1"},
    "registration_owner": {"enum": ["technology", "workmethod", "event-compute"]},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "script", "uuid"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "script": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.py$"},
          "uuid": {"type": "string", "pattern": "^[0-9A-Fa-f-]{36}$"}
        }
      }
    },
    "rule_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "event", "active"],
        "properties": {
          "rule": {"type": "string", "minLength": 1},
          "event": {"type": "string", "minLength": 1},
          "active": {"type": "boolean"}
        }
      }
    },
    "runtime_validation": {"enum": ["pending", "passed", "failed"]}
  }
}
