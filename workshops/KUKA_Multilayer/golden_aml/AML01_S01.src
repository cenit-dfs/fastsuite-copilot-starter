;FOLD Root Layer ;%{PO}

; Operation: Seam01_Layer1_Bead1

;FOLD ARCON WDAT01_01_050 LIN P001 Vel=0.5 m/s CPDATP001 Tool[1]:Torch Base[5]:Part ;%{PE}
  ;FOLD Parameters ;%{h}
    ;Params IlfProvider=kukaroboter.arctech.arconlin; Kuka.IsGlobalPoint=False; Kuka.PointName=P001; Kuka.BlendingEnabled=True; Kuka.MoveDataName=CPDATP001; Kuka.VelocityPath=0.008; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; ArcTech.WdatVarName=WDAT01_01_050; ArcTech.Basic=3.7.2.112; ArcTech.Advanced=3.7.1.9; ArcTech.Sense=3.7.1; ArcTech.Multilayer=3.7.1.4; ArcTech.ML.Id=78007cee-bb13-5d94-b043-b37467b95f00
  ;ENDFOLD
  $BWDSTART = FALSE
  LDAT_ACT = LCPDATP001
  FDAT_ACT = FP001
  BAS(#CP_PARAMS,0.5)
  SET_CD_PARAMS (0)
  TRIGGER WHEN DISTANCE = 1 DELAY = ArcGetDelay(#PreDefinition, WDAT01_01_050) DO ArcMainNG(#PreDefinition, WDAT01_01_050, WP001) PRIO = -1
  TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT01_01_050) DELAY = ArcGetDelay(#GasPreflow, WDAT01_01_050) DO ArcMainNG(#GasPreflow, WDAT01_01_050, WP001) PRIO = -1
  TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, WDAT01_01_050) DELAY = ArcGetDelay(#ArcPreOn, WDAT01_01_050) DO ArcMainNG(#ArcOnMoveStd, WDAT01_01_050, WP001) PRIO = -1 
  ArcMainNG(#ArcOnBeforeMoveStd, WDAT01_01_050, WP001)
  LIN XP001 
  ArcMainNG(#ArcOnAfterMoveStd, WDAT01_01_050, WP001)
  TRIGGER WHEN DISTANCE = 0 DELAY = ArcGetDelay(#MlDelayArcOn, WDAT01_01_050) DO AmlSetPos(#ArcOnMoveStd, WDAT01_01_050, WP001, ) PRIO = -1
;ENDFOLD

;FOLD ARCOFF WDAT01_01_050 LIN P002 Vel=0.025 m/s CPDATP002 Tool[1]:Torch Base[5]:Part ;%{PE}
  ;FOLD Parameters ;%{h}
    ;Params IlfProvider=kukaroboter.arctech.arcofflin; Kuka.IsGlobalPoint=False; Kuka.PointName=P002; Kuka.BlendingEnabled=True; Kuka.MoveDataName=CPDATP002; Kuka.VelocityPath=0.008; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; ArcTech.WdatVarName=WDAT01_01_050; ArcTech.Basic=3.7.2.112; ArcTech.Advanced=3.7.1.9; ArcTech.Sense=3.7.1; ArcTech.Multilayer=3.7.1.4; ArcTech.ML.Id=99b1ec54-f02c-5196-9ba4-36c4223a64e2
  ;ENDFOLD
  $BWDSTART = FALSE
  LDAT_ACT = LCPDATP002
  FDAT_ACT = FP002
  BAS(#CP_PARAMS, gArcBasVelDefinition)
  SET_CD_PARAMS (0)
  TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore, WDAT01_01_050) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd, WDAT01_01_050, WP002) PRIO = -1
  TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore2, WDAT01_01_050) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd2, WDAT01_01_050, WP002) PRIO = -1
  TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOff, WDAT01_01_050) DELAY = 0 DO ArcMainNG(#ArcOffMoveStd, WDAT01_01_050, WP002) PRIO = -1
  TRIGGER WHEN PATH = ArcGetPath(#MlPathArcOff, WDAT01_01_050) DELAY = ArcGetDelay(#MlDelayArcOff, WDAT01_01_050) DO AmlSetPos(#ArcOffMoveStd, WDAT01_01_050, WP002, ) PRIO = -1
  ArcMainNG(#ArcOffBeforeMoveStd, WDAT01_01_050, WP002)
  LIN XP002 
  ArcMainNG(#ArcOffAfterMoveStd, WDAT01_01_050, WP002)
;ENDFOLD
;FOLD  ;%{h}
  AmlBlockCaseEnd(gAmlActLayer, AmlInfo)
;ENDFOLD
;ENDFOLD End Root Layer ;%{V}
;FOLD Layer 1 [-->] {LayerOffset1} ;%{P} ;FOLD SPLINE MULTILAYER
;FOLD  ;%{H}
;FOLD Parameters ;%{h}
;Params IlfProvider=KukaRoboter.ArcTech.Multilayer.Layer; ArcTech.ML.LayerDirection=Direct; ArcTech.ML.LayerNumber=1; ArcTech.ML.LayerFrameShift=LayerOffset1; ArcTech.Basic=3.7.2.112; ArcTech.Multilayer=3.7.1.4
;ENDFOLD
CASE 1
  AmlBlockCaseBegin(gAmlActLayer, AmlInfo)
;ENDFOLD

; Operation: Seam01_Layer2_Bead1

