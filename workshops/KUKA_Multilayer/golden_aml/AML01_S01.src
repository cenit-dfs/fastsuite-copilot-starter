  TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore, L1_WDAT02_01_050) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd, L1_WDAT02_01_050, WP002) PRIO = -1
  TRIGGER WHEN PATH = ArcGetPath(#ArcOffBefore2, L1_WDAT02_01_050) DELAY = 0 DO ArcMainNG(#ArcOffBeforeOffStd2, L1_WDAT02_01_050, WP002) PRIO = -1
  TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOff, L1_WDAT02_01_050) DELAY = 0 DO ArcMainNG(#ArcOffMoveStd, L1_WDAT02_01_050, WP002) PRIO = -1
  ArcMainNG(#ArcOffBeforeMoveStd, L1_WDAT02_01_050, WP002)
  LIN AmlGetPos(XP002, LayerOffset1, WP002, AmlInfo, )
