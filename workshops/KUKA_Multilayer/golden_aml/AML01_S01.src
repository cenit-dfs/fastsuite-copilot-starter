    ;Params IlfProvider=kukaroboter.arctech.arconlin; Kuka.IsGlobalPoint=False; Kuka.PointName=P001; Kuka.BlendingEnabled=True; Kuka.MoveDataName=CPDATP001; Kuka.VelocityPath=0.008; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; ArcTech.WdatVarName=L1_WDAT02_01_050; ArcTech.Basic=3.7.2.112; ArcTech.Advanced=3.7.1.9; ArcTech.Sense=3.7.1; ArcTech.Multilayer=3.7.1.4; ArcTech.ML.Id=78007cee-bb13-5d94-b043-b37467b95f00
