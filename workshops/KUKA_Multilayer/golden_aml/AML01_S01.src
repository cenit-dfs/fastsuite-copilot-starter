  TRIGGER WHEN PATH = ArcGetPath(#OnTheFlyArcOn, L1_WDAT02_01_050) DELAY = ArcGetDelay(#ArcPreOn, L1_WDAT02_01_050) DO ArcMainNG(#ArcOnMoveStd, L1_WDAT02_01_050, WP001) PRIO = -1 
  ArcMainNG(#ArcOnBeforeMoveStd, L1_WDAT02_01_050, WP001)
  LIN AmlGetPos(XP001, LayerOffset1, WP001, AmlInfo, )
  ArcMainNG(#ArcOnAfterMoveStd, L1_WDAT02_01_050, WP001)
;ENDFOLD

;FOLD MLARCOFF L1_WDAT02_01_050 LIN ShiftedP002 Vel=0.025 m/s CPDATP002 Tool[1]:Torch Base[5]:Part ;%{PE}
  ;FOLD Parameters ;%{h}
    ;Params IlfProvider=kukaroboter.arctech.arcofflin; Kuka.IsGlobalPoint=False; Kuka.PointName=P002; Kuka.BlendingEnabled=True; Kuka.MoveDataName=CPDATP002; Kuka.VelocityPath=0.008; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; ArcTech.WdatVarName=L1_WDAT02_01_050; ArcTech.Basic=3.7.2.112; ArcTech.Advanced=3.7.1.9; ArcTech.Sense=3.7.1; ArcTech.Multilayer=3.7.1.4; ArcTech.ML.Id=99b1ec54-f02c-5196-9ba4-36c4223a64e2
